@page
@model ReportesModel
@{ViewData["Title"]="Reportes y estadísticas";}
<form method="get" class="panel filters"><label>Ejercicio<input asp-for="Year" type="number" min="1900" max="9999"/></label><label>Mes<select asp-for="Month"><option value="">Todo el año</option>@for(int i=1;i<=12;i++){<option value="@i">@System.Globalization.CultureInfo.GetCultureInfo("es-MX").DateTimeFormat.GetMonthName(i)</option>}</select></label><label>Desde<input asp-for="From" type="date"/></label><label>Hasta<input asp-for="To" type="date"/></label><label>Fecha base<select asp-for="ByIssue"><option value="false">Recepción</option><option value="true">Expedición</option></select></label><button class="btn btn-primary">Consultar</button></form>
<div class="toolbar"><span>@Model.Items.Count trámites en el periodo</span><div><a class="btn btn-outline-primary" asp-page-handler="Excel" asp-route-Year="@Model.Year" asp-route-Month="@Model.Month" asp-route-From="@Model.From?.ToString("yyyy-MM-dd")" asp-route-To="@Model.To?.ToString("yyyy-MM-dd")" asp-route-ByIssue="@Model.ByIssue">Excel estadístico</a><a class="btn btn-outline-primary" asp-page-handler="Pdf" asp-route-Year="@Model.Year" asp-route-Month="@Model.Month" asp-route-From="@Model.From?.ToString("yyyy-MM-dd")" asp-route-To="@Model.To?.ToString("yyyy-MM-dd")" asp-route-ByIssue="@Model.ByIssue" target="_blank">Previsualizar PDF</a><a class="btn btn-outline-primary" asp-page-handler="Pdf" asp-route-download="true" asp-route-Year="@Model.Year" asp-route-Month="@Model.Month" asp-route-From="@Model.From?.ToString("yyyy-MM-dd")" asp-route-To="@Model.To?.ToString("yyyy-MM-dd")" asp-route-ByIssue="@Model.ByIssue">Descargar PDF</a></div></div>
<div class="two-columns">@foreach(var (title,values) in Model.Groups){<section class="panel"><h2>@title</h2>@foreach(var (label,count) in values){<div class="chart-row"><div><span>@label</span><strong>@count <small>(@(Model.Items.Count==0?"0":(100d*count/Model.Items.Count).ToString("0.0"))%)</small></strong></div><meter min="0" max="@Math.Max(1,Model.Items.Count)" value="@count">@count</meter></div>}@if(values.Count==0){<p class="empty">Sin datos en el periodo.</p>}</section>}</div>
