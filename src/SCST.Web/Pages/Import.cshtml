@page
@model ImportModel
@{ViewData["Title"]="Importar desde Excel";}
<div class="panel"><p>Cargue el libro original o la plantilla SCST. Revise los nombres antes de confirmar. Los registros existentes se omiten y los folios repetidos dentro del archivo se rechazan en todas sus apariciones.</p><a asp-page-handler="Template">Descargar plantilla estandarizada</a><div asp-validation-summary="All" class="text-danger"></div><form method="post" enctype="multipart/form-data" class="toolbar"><label>Archivo Excel<input asp-for="Upload" type="file" accept=".xlsx" required/></label><button class="btn btn-primary">Leer y validar</button></form></div>
@if(Model.Token!=null){<div class="panel"><h2>@(Model.Imported.HasValue?"Resultado de importación":"Vista previa")</h2><p>Procesadas: @Model.Rows.Count · Válidas: @Model.Rows.Count(x=>x.Errors.Count==0) · Omitidas: @Model.Rows.Count(x=>x.Exists) · Inválidas: @Model.Rows.Count(x=>x.Errors.Count>0&&!x.Exists) @if(Model.Imported.HasValue){<strong>· Importadas: @Model.Imported</strong>}</p><form method="post" asp-page-handler="Errors"><input asp-for="Token" type="hidden"/><button class="btn btn-outline-primary">Descargar filas rechazadas</button></form><form method="post" asp-page-handler="Confirm" class="mt-3"><input asp-for="Token" type="hidden"/><div class="table-responsive"><table class="table"><thead><tr><th>Fila / folio</th><th>Nombre(s)</th><th>Primer apellido</th><th>Segundo apellido</th><th>Validación</th></tr></thead><tbody>@foreach(var r in Model.Rows){<tr><td>@r.Row · @r.Data.Folio</td><td><input name="names_@(r.Row)_n" value="@r.Data.Names" aria-label="Nombres fila @r.Row"/></td><td><input name="names_@(r.Row)_p" value="@r.Data.FirstSurname" aria-label="Primer apellido fila @r.Row"/></td><td><input name="names_@(r.Row)_m" value="@r.Data.SecondSurname" aria-label="Segundo apellido fila @r.Row"/></td><td>@(r.Errors.Count==0?"Válido":string.Join(" ",r.Errors))</td></tr>}</tbody></table></div>@if(!Model.Imported.HasValue){<button class="btn btn-primary" data-confirm-button="¿Importar únicamente las filas válidas revisadas?">Confirmar importación parcial</button>}</form></div>}
