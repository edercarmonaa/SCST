@page
@model SCST.Web.Pages.Tramites.IndexModel
@{ViewData["Title"]="Trámites";}
<div class="toolbar"><p class="muted">Consulte los expedientes y su seguimiento.</p>@if(Model.CanWrite){<a class="btn btn-primary" asp-page="Edit">Nuevo trámite</a>}</div>
<div asp-validation-summary="All" class="text-danger"></div><form method="get" class="panel filters" hx-get="/Tramites" hx-target="#results" hx-trigger="submit, input changed delay:450ms from:input[name='Text']"><label class="search">Buscar folio o solicitante<input asp-for="Text" placeholder="Escriba para buscar…" type="search"/></label><label>Ejercicio<input asp-for="Year" type="number"/></label><label class="check"><input asp-for="All"/>Todos los ejercicios</label><details><summary>Filtros administrativos</summary><div class="form-grid">@foreach(var (name,kind,value) in new[]{("Status",CatalogKind.Estatus,Model.Status),("Type",CatalogKind.TipoTramite,Model.Type),("Level",CatalogKind.NivelEducativo,Model.Level),("Validator",CatalogKind.Validador,Model.Validator)}){<label>@kind<select name="@name"><option value="">Todos</option>@foreach(var c in Model.Catalogs.Where(x=>x.Kind==kind)){<option value="@c.Id" selected="@(c.Id==value)">@c.Name</option>}</select></label>}<label>Semáforo<select asp-for="Signal"><option value="">Todos</option><option>Verde</option><option>Amarillo</option><option>Rojo</option></select></label></div><label class="check"><input asp-for="Historical"/>Pendientes históricos</label><label class="check"><input asp-for="WithoutLetter"/>Sin oficio relacionado</label></details><button class="btn btn-secondary">Aplicar filtros</button><a asp-page="Index">Limpiar</a></form>
<details class="panel compact"><summary>Columnas visibles</summary><form method="post" asp-page-handler="Columns"><div class="column-options">@foreach(var c in new[]{"Folio","Nombre","Recepción","Tipo","Nivel","Estatus","Validador","Semáforo","Validación","Ejercicio","CCT","TL"}){<label class="check"><input name="columns" value="@c" type="checkbox" checked="@(Model.Columns.Split(',').Contains(c))"/>@c</label>}</div><button class="btn btn-sm btn-secondary">Guardar preferencia</button></form></details>
<div id="results"><partial name="_Table" model="Model"/></div>
