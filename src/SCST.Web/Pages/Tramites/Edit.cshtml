@page "{id:int?}"
@model SCST.Web.Pages.Tramites.EditModel
@{ViewData["Title"]=Model.Input.Id==0?"Nuevo trámite":"Editar trámite · "+Model.Input.Folio;}
<a asp-page="Index">Trámites</a><div class="panel mt-3"><div asp-validation-summary="All" class="text-danger" role="alert"></div><form method="post" data-dirty><input asp-for="Input.Id" type="hidden"/><input asp-for="Input.Version" type="hidden"/>
<div class="tabs" role="tablist"><button type="button" class="active" data-tab="general" role="tab">Datos generales</button><button type="button" data-tab="dates" role="tab">Fechas</button><button type="button" data-tab="notes" role="tab">Observaciones</button></div>
<section data-tab-panel="general"><div class="form-grid">
<label>Folio DAAC *<input asp-for="Input.Folio" required/></label>
<label>Fecha de ingreso *<input asp-for="Input.Reception" type="date" required/></label>
<label>Medio de ingreso<select asp-for="Input.MediumId"><option value="">Seleccione</option>@foreach(var c in Model.Catalogs.Where(c=>c.Kind==CatalogKind.MedioIngreso&&(c.Active||c.Id==Model.Input.MediumId))){<option value="@c.Id">@c.Name @(!c.Active?"(inactivo)":"")</option>}</select></label>
<label>Folio TL<input asp-for="Input.TlFolio"/></label>
<label>Nombre o nombres *<input asp-for="Input.Names" required/></label><label>Primer apellido *<input asp-for="Input.FirstSurname" required/></label><label>Segundo apellido<input asp-for="Input.SecondSurname"/></label>
@foreach(var (field,kind,current) in new[]{("TypeId",CatalogKind.TipoTramite,(int?)Model.Input.TypeId),("LevelId",CatalogKind.NivelEducativo,(int?)Model.Input.LevelId),("StatusId",CatalogKind.Estatus,(int?)Model.Input.StatusId),("ValidatorId",CatalogKind.Validador,Model.Input.ValidatorId)}){<label>@kind<select name="Input.@field"><option value="">@(kind==CatalogKind.Validador?"Sin asignar":"Seleccione")</option>@foreach(var c in Model.Catalogs.Where(c=>c.Kind==kind&&(c.Active||c.Id==current))){<option value="@c.Id" selected="@(c.Id==current)">@c.Name @(!c.Active?"(inactivo)":"")</option>}</select></label>}
<label>CCT<input asp-for="Input.Cct"/></label><label>Ciclo escolar<input asp-for="Input.SchoolCycle"/></label><label>Folio de certificado<input asp-for="Input.CertificateFolio"/></label></div></section>
<section data-tab-panel="dates" hidden><div class="form-grid"><label>Respuesta de validador<input asp-for="Input.ValidatorResponse" type="date"/></label><label>Captura en el sistema<input asp-for="Input.SourceCapture" type="date"/></label><label>Expedición<input asp-for="Input.Issue" type="date"/></label><label>Fecha de respuesta a ventanilla<input asp-for="Input.WindowResponse" type="date"/></label></div><p class="muted">El ejercicio se calcula desde la fecha de ingreso. La fecha de respuesta a ventanilla se utiliza como fecha de conclusión. Las fechas técnicas de captura y modificación son automáticas.</p><label class="check"><input asp-for="ConfirmDates"/>Confirmo las fechas futuras o anteriores al ingreso después de revisarlas.</label></section>
<section data-tab-panel="notes" hidden><label>Documentación / anexos<textarea asp-for="Input.Documentation" rows="3"></textarea></label><label>Incidencia / pendiente<textarea asp-for="Input.Incident" rows="3"></textarea></label><label>Observaciones<textarea asp-for="Input.Observations" rows="5"></textarea></label></section>
<div class="form-actions"><button class="btn btn-primary">Guardar expediente</button><a class="btn btn-outline-secondary" asp-page="Index">Cancelar</a></div></form>@if(Model.Input.Id!=0){<p class="mt-3">Consulte las pestañas <a asp-page="Detail" asp-route-id="@Model.Input.Id" asp-fragment="follow">Seguimiento y reingresos</a> y <a asp-page="Detail" asp-route-id="@Model.Input.Id" asp-fragment="letters">Oficios</a> en el expediente.</p>}</div>
