@page "{id:int}"
@model SCST.Web.Pages.Tramites.DetailModel
@{var t=Model.Item;ViewData["Title"]="Expediente · "+t.Folio;}
<div class="toolbar"><a asp-page="Index">← Volver a trámites</a><div>@if(Model.CanWrite){<a class="btn btn-primary" asp-page="Edit" asp-route-id="@t.Id">Editar</a>}<a class="btn btn-outline-primary" asp-page-handler="Pdf" asp-route-id="@t.Id" target="_blank">Previsualizar carátula</a><a class="btn btn-outline-primary" asp-page-handler="Pdf" asp-route-id="@t.Id" asp-route-download="true">Descargar PDF</a></div></div><div asp-validation-summary="All" class="text-danger"></div>
<section class="panel"><div class="detail-title"><div><span class="eyebrow">@t.Type.Name · Ejercicio @t.Year</span><h2>@t.FullName</h2></div><span class="status">@t.Status.Name</span></div><dl class="details"><dt>Nivel educativo</dt><dd>@t.Level.Name</dd><dt>Fecha de ingreso</dt><dd>@t.Reception.ToString("dd/MM/yyyy")</dd><dt>Validador</dt><dd>@(t.Validator?.Name??"Sin asignar")</dd><dt>Semáforo</dt><dd>@(t.Signal(DateOnly.FromDateTime(DateTime.Today),t.Status.Pending)?.ToString()??"Fuera del semáforo")</dd><dt>CCT</dt><dd>@t.Cct</dd><dt>Folio TL</dt><dd>@t.TlFolio</dd><dt>Ciclo escolar</dt><dd>@t.SchoolCycle</dd><dt>Certificado</dt><dd>@t.CertificateFolio</dd><dt>Medio de ingreso</dt><dd>@t.Medium?.Name</dd><dt>Respuesta del validador</dt><dd>@t.ValidatorResponse</dd><dt>Captura en el sistema</dt><dd>@t.SourceCapture</dd><dt>Expedición</dt><dd>@t.Issue</dd><dt>Fecha de respuesta a ventanilla</dt><dd>@t.WindowResponse</dd></dl><label>Documentación / anexos</label><p class="pre-wrap">@t.Documentation</p><label>Incidencia / pendiente</label><p class="pre-wrap">@t.Incident</p><label>Observaciones</label><p class="pre-wrap">@t.Observations</p><small class="muted">Capturado @t.CreatedUtc.ToLocalTime() · Modificado @t.ModifiedUtc.ToLocalTime()</small></section>
<section class="panel" id="follow"><h2>Seguimiento</h2>@foreach(var f in t.FollowUps.OrderByDescending(x=>x.Date).ThenByDescending(x=>x.CreatedUtc)){<article class="timeline"><strong>@f.Date.ToString("dd/MM/yyyy") · @(f.Responsible?.Name??"Sin asignar")</strong><p class="pre-wrap">@f.Activity</p><p class="pre-wrap">@f.Observations</p><small>Capturó @f.User.Name · @f.CreatedUtc.ToLocalTime()</small>@if(Model.CanWrite){<div class="toolbar"><a asp-route-id="@t.Id" asp-route-follow="@f.Id">Editar actividad</a><form method="post" asp-page-handler="DeleteChild" asp-route-id="@t.Id" data-confirm="¿Enviar este seguimiento a papelera?"><input name="entity" value="FollowUp" type="hidden"/><input name="child" value="@f.Id" type="hidden"/><button class="btn btn-sm btn-outline-danger">Eliminar</button></form></div>}</article>}@if(t.FollowUps.Count==0){<p class="empty">Sin actividades registradas.</p>}
@if(Model.CanWrite){<details open="@(Model.Follow.Id>0)"><summary>@(Model.Follow.Id==0?"Registrar actividad":"Editar actividad")</summary><form method="post" asp-page-handler="Follow" asp-route-id="@t.Id"><input asp-for="Follow.Id" type="hidden"/><div class="form-grid"><label>Fecha de actividad<input asp-for="Follow.Date" type="date" required/></label><label>Responsable<select asp-for="Follow.ResponsibleId"><option value="">Sin asignar</option>@foreach(var v in Model.Validators.Where(v=>v.Active||v.Id==Model.Follow.ResponsibleId)){<option value="@v.Id">@v.Name</option>}</select></label></div><label>Actividad<textarea asp-for="Follow.Activity" required></textarea></label><label>Observaciones<textarea asp-for="Follow.Observations"></textarea></label><button class="btn btn-primary">Guardar actividad</button></form></details>}</section>
<section class="panel"><h2>Reingresos</h2>@foreach(var r in t.Reentries.OrderByDescending(r=>r.Date)){<article class="timeline"><strong>@r.Date.ToString("dd/MM/yyyy")</strong><p>@r.Reason</p><p>@r.Observations</p>@if(Model.CanWrite){<form method="post" asp-page-handler="DeleteChild" asp-route-id="@t.Id" data-confirm="¿Enviar este reingreso a papelera?"><input name="entity" value="Reentry" type="hidden"/><input name="child" value="@r.Id" type="hidden"/><button class="btn btn-sm btn-outline-danger">Eliminar</button></form>}</article>}@if(t.Reentries.Count==0){<p class="empty">Sin reingresos registrados.</p>}@if(Model.CanWrite){<details><summary>Registrar reingreso</summary><form method="post" asp-page-handler="Reentry" asp-route-id="@t.Id"><label>Fecha<input asp-for="Reentry.Date" type="date" required/></label><label>Motivo<input asp-for="Reentry.Reason" required/></label><label>Observaciones<textarea asp-for="Reentry.Observations"></textarea></label><button class="btn btn-primary">Guardar reingreso</button></form></details>}</section>
<section class="panel" id="letters"><h2>Oficios relacionados</h2>@foreach(var l in t.Letters.OrderBy(l=>l.Oficio.Number)){<p><a asp-page="/Oficios/Detail" asp-route-id="@l.OficioId">@l.Oficio.Number · @l.Oficio.Year</a></p>}@if(t.Letters.Count==0){<p class="empty">Sin oficios relacionados. Vincule el expediente desde el módulo Oficios.</p>}</section>
@if(Model.CanWrite){<form method="post" asp-page-handler="Delete" asp-route-id="@t.Id" data-confirm="¿Enviar este expediente a papelera? Se conservarán folio y relaciones."><button class="btn btn-outline-danger">Enviar expediente a papelera</button></form>}
