@model SCST.Web.Pages.Tramites.IndexModel
@{var columns=Model.Columns.Split(',');}
<form method="post"><div class="panel table-panel"><div class="table-heading"><span><strong>@Model.Count</strong> expedientes</span><a asp-page="Index" asp-page-handler="Excel" asp-route-Year="@Model.Year" asp-route-All="@Model.All" asp-route-Text="@Model.Text" asp-route-Status="@Model.Status" asp-route-Type="@Model.Type" asp-route-Level="@Model.Level" asp-route-Validator="@Model.Validator" asp-route-Historical="@Model.Historical" asp-route-WithoutLetter="@Model.WithoutLetter" asp-route-Signal="@Model.Signal">Exportar filtro a Excel</a></div><div class="table-responsive"><table class="table"><thead><tr>@if(Model.CanWrite){<th><input type="checkbox" data-select-all aria-label="Seleccionar todos en esta página"/></th>}@foreach(var c in columns){<th>@c</th>}<th>Expediente</th></tr></thead><tbody>@foreach(var t in Model.Items){<tr>@if(Model.CanWrite){<td><input type="checkbox" name="Selected" value="@t.Id" aria-label="Seleccionar @t.Folio"/></td>}@foreach(var c in columns){<td>@switch(c){case "Folio":<strong>@t.Folio</strong>break;case "Nombre":@t.FullName break;case "Recepción":@t.Reception.ToString("dd/MM/yyyy") break;case "Tipo":@t.Type.Name break;case "Nivel":@t.Level.Name break;case "Estatus":<span class="status">@t.Status.Name</span>break;case "Validador":@(t.Validator?.Name??"Sin asignar") break;case "Semáforo":var signal=t.Signal(DateOnly.FromDateTime(DateTime.Today),t.Status.Pending);if(signal!=null){<span class="signal @signal.ToString()!.ToLowerInvariant()">@signal</span>}break;case "Validación":@t.Validation break;case "Ejercicio":@t.Year break;case "CCT":@t.Cct break;case "TL":@t.TlFolio break;}</td>}<td><a asp-page="Detail" asp-route-id="@t.Id">Abrir</a></td></tr>}@if(Model.Items.Count==0){<tr><td colspan="20" class="empty">No hay expedientes que coincidan con los filtros.</td></tr>}</tbody></table></div>
@if(Model.CanWrite){<div class="bulk"><span>Sobre los seleccionados:</span><select asp-for="BulkStatus" aria-label="Nuevo estatus"><option value="">Conservar estatus</option>@foreach(var c in Model.Catalogs.Where(c=>c.Kind==CatalogKind.Estatus)){<option value="@c.Id">@c.Name</option>}</select><select asp-for="BulkValidator" aria-label="Asignar validador"><option value="">Conservar validador</option>@foreach(var c in Model.Catalogs.Where(c=>c.Kind==CatalogKind.Validador)){<option value="@c.Id">@c.Name</option>}</select><button name="action" value="bulk" class="btn btn-secondary">Aplicar</button><button name="action" value="excel" class="btn btn-outline-primary">Excel</button><button name="action" value="pdf" class="btn btn-outline-primary" formtarget="_blank">Carátulas PDF</button></div>}
<div class="pagination-row"><span>Página @Model.P de @Math.Max(1,(int)Math.Ceiling(Model.Count/25d)) · 25 por página</span>@if(Model.P>1){<a href="@Url.Page("Index",new{Model.Year,Model.All,Model.Text,Model.Status,Model.Type,Model.Level,Model.Validator,Model.Historical,Model.WithoutLetter,Model.Signal,P=Model.P-1})">Anterior</a>}@if(Model.P*25<Model.Count){<a href="@Url.Page("Index",new{Model.Year,Model.All,Model.Text,Model.Status,Model.Type,Model.Level,Model.Validator,Model.Historical,Model.WithoutLetter,Model.Signal,P=Model.P+1})">Siguiente</a>}</div></div></form>
