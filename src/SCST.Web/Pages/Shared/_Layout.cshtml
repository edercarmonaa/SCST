@inject Database Db
@{var settings=Db.Settings.AsNoTracking().SingleOrDefault();var write=User.IsInRole("Administrador")||User.IsInRole("Capturista");}
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · SCST</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/site.css"/><script src="~/lib/htmx/htmx.min.js" defer></script><script src="~/js/site.js" defer></script></head>
<body><a class="skip" href="#content">Ir al contenido</a><header class="institution"><img src="~/images/institutional/veracruz-institucional.png" alt="Gobierno del Estado de Veracruz, SEV, UPECE, SAE"/><div class="identity"><strong>Sistema de Control y Seguimiento de Trámites (SCST)</strong></div></header>
<div class="shell"><aside><a class="brand" asp-page="/Index">SCST <small>Control administrativo</small></a>
@if(User.Identity?.IsAuthenticated==true){<nav aria-label="Navegación principal"><a asp-page="/Index">Inicio</a><a asp-page="/Tramites/Index">Trámites</a><a asp-page="/Oficios/Index">Oficios</a><a asp-page="/Reportes">Reportes y estadísticas</a>@if(write){<a asp-page="/Import">Importar Excel</a><a asp-page="/Trash">Papelera</a>}@if(User.IsInRole("Administrador")){<span class="nav-label">Administración</span><a asp-page="/Admin/Catalogs">Catálogos y validadores</a><a asp-page="/Admin/Users">Usuarios</a><a asp-page="/Admin/Settings">Configuración</a><a asp-page="/Admin/Backups">Respaldos y restauración</a><a asp-page="/Admin/Audit">Auditoría</a>}</nav><div class="session"><a asp-page="/Account/Profile">@User.Identity.Name</a><small>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</small><form method="post" asp-page="/Account/Logout"><button class="btn btn-sm btn-outline-light">Cerrar sesión</button></form></div>}
<img class="state-mark" src="~/images/institutional/veracruz-marca.png" alt="Por amor a Veracruz"/></aside><main id="content"><div class="page-heading"><div><span class="eyebrow">Gestión de expedientes</span><h1>@ViewData["Title"]</h1></div><span class="local-label">Operación local</span></div>
@if(TempData["Message"] is string message){<div class="alert alert-success" role="status">@message</div>}
@RenderBody()<footer>SCST · @settings?.Year · Información administrativa de acceso autorizado</footer></main></div></body></html>
