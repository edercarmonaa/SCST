@page
@model IndexModel
@{ViewData["Title"]="Panel de control";}
<form method="get" class="toolbar"><label>Ejercicio<input asp-for="Year" type="number"/></label><button class="btn btn-secondary">Consultar</button><a class="btn btn-primary" asp-page="/Tramites/Edit">Registrar trámite</a></form>
<div class="metrics"><a class="metric" asp-page="/Tramites/Index" asp-route-Year="@Model.Year"><span>Total de trámites</span><strong>@Model.Items.Count</strong><small>Ejercicio @Model.Year</small></a>@foreach(var s in Model.Groups["Semáforos"].Where(x=>x.Key!="Fuera del semáforo")){<a class="metric @s.Key.ToLowerInvariant()" asp-page="/Tramites/Index" asp-route-Year="@Model.Year" asp-route-Signal="@s.Key"><span>Pendientes · @s.Key</span><strong>@s.Value</strong><small>Días desde recepción original</small></a>}<a class="metric historic" asp-page="/Tramites/Index" asp-route-All="true" asp-route-Historical="true"><span>Pendientes históricos</span><strong>@Model.Historical</strong><small>Ejercicios anteriores</small></a></div>
<div class="two-columns"><section class="panel"><h2>Situación del ejercicio</h2>@foreach(var s in Model.Groups["Estatus"]){<div class="summary-row"><span>@s.Key</span><strong>@s.Value</strong></div>}@if(Model.Items.Count==0){<p class="empty">No hay trámites registrados en este ejercicio.</p>}</section><section class="panel"><h2>Accesos de trabajo</h2><p>Consulte expedientes, registre actividades y mantenga al día el seguimiento administrativo.</p><a class="action-link" asp-page="/Tramites/Index">Consultar trámites →</a><a class="action-link" asp-page="/Oficios/Index">Consultar oficios →</a><a class="action-link" asp-page="/Reportes">Ver estadísticas →</a></section></div>
