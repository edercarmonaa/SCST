@page "{id:int}"
@model SCST.Web.Pages.Oficios.DetailModel
@{ViewData["Title"]="Oficio · "+Model.Input.Number;}
<a asp-page="Index">← Volver a oficios</a><div asp-validation-summary="All" class="text-danger"></div><section class="panel"><form method="post"><input asp-for="Input.Version" type="hidden"/><div class="form-grid"><label>Número<input asp-for="Input.Number" readonly="@(!Model.CanWrite)"/></label><label>Ejercicio<input asp-for="Input.Year" readonly="@(!Model.CanWrite)"/></label><label>Fecha<input asp-for="Input.Date" type="date" readonly="@(!Model.CanWrite)"/></label></div><label>Observaciones<textarea asp-for="Input.Observations" readonly="@(!Model.CanWrite)"></textarea></label>@if(Model.CanWrite){<button class="btn btn-primary">Guardar oficio</button>}</form></section>
<section class="panel"><h2>Expedientes asociados · @Model.Input.Tramites.Count</h2><div class="summary-inline">@foreach(var group in Model.Input.Tramites.GroupBy(l=>l.Tramite.Status.Name)){<span>@group.Key: @group.Count()</span>}</div><form method="post" asp-page-handler="Link" asp-route-unlink="true" data-confirm="¿Desvincular los expedientes seleccionados?"><div class="table-responsive"><table class="table"><thead><tr>@if(Model.CanWrite){<th>Seleccionar</th>}<th>Folio</th><th>Solicitante</th><th>Estatus</th></tr></thead><tbody>@foreach(var l in Model.Input.Tramites.OrderBy(x=>x.Tramite.Folio)){<tr>@if(Model.CanWrite){<td><input type="checkbox" name="Selected" value="@l.TramiteId" aria-label="Seleccionar @l.Tramite.Folio"/></td>}<td><a asp-page="/Tramites/Detail" asp-route-id="@l.TramiteId">@l.Tramite.Folio</a></td><td>@l.Tramite.FullName</td><td>@l.Tramite.Status.Name</td></tr>}</tbody></table></div>@if(Model.CanWrite){<button class="btn btn-outline-danger">Desvincular seleccionados</button>}</form></section>
@if(Model.CanWrite){<section class="panel"><h2>Vincular trámites</h2><form method="get" class="toolbar"><label>Buscar por folio o nombre<input asp-for="Text" required/></label><button class="btn btn-secondary">Buscar</button></form><form method="post" asp-page-handler="Link">@foreach(var t in Model.Available){<label class="check"><input type="checkbox" name="Selected" value="@t.Id"/>@t.Folio · @t.FullName</label>}@if(Model.Available.Count>0){<button class="btn btn-primary">Vincular seleccionados</button><small>Se muestran hasta 50 coincidencias.</small>}</form></section><form method="post" asp-page-handler="Delete" data-confirm="¿Enviar este oficio a papelera conservando sus asociaciones?"><button class="btn btn-outline-danger">Enviar oficio a papelera</button></form>}
