@page
@model SCST.Web.Pages.Oficios.IndexModel
@{ViewData["Title"]="Oficios";}
<form method="get" class="toolbar"><label>Buscar número<input asp-for="Text" type="search"/></label><button class="btn btn-secondary">Buscar</button></form><div asp-validation-summary="All" class="text-danger"></div><div class="panel table-responsive"><table class="table"><thead><tr><th>Número</th><th>Ejercicio</th><th>Fecha</th><th></th></tr></thead><tbody>@foreach(var o in Model.Items){<tr><td>@o.Number</td><td>@o.Year</td><td>@o.Date</td><td><a asp-page="Detail" asp-route-id="@o.Id">Abrir</a></td></tr>}@if(Model.Count==0){<tr><td colspan="4" class="empty">No hay oficios registrados.</td></tr>}</tbody></table><div class="pagination-row"><span>@Model.Count oficios · Página @Model.P</span>@if(Model.P>1){<a asp-route-P="@(Model.P-1)" asp-route-Text="@Model.Text">Anterior</a>}@if(Model.P*25<Model.Count){<a asp-route-P="@(Model.P+1)" asp-route-Text="@Model.Text">Siguiente</a>}</div></div>
@if(Model.CanWrite){<section class="panel"><h2>Nuevo oficio</h2><form method="post"><div class="form-grid"><label>Número<input asp-for="Input.Number" required/></label><label>Ejercicio<input asp-for="Input.Year" required min="1900" max="9999"/></label><label>Fecha<input asp-for="Input.Date" type="date"/></label></div><label>Observaciones<textarea asp-for="Input.Observations"></textarea></label><button class="btn btn-primary">Registrar oficio</button></form></section>}
