@page
@model SetupModel
@{ViewData["Title"]="Configuración inicial";}
<div class="panel narrow"><p>Prepare la cuenta administradora y los datos institucionales. Los datos se almacenarán en <code>@Model.Storage</code>. Puede definir otra ubicación con SCST_DATA antes del primer inicio.</p><div asp-validation-summary="All" class="text-danger" role="alert"></div>
<form method="post" asp-page-handler="Key"><button class="btn btn-outline-primary">1. Generar clave de recuperación</button></form>
@if(Model.Recovery!=null){<div class="alert alert-warning mt-3"><strong>Guarde esta clave fuera del equipo.</strong><p>Permite recuperar los respaldos en otra computadora. No se incluye dentro del respaldo.</p><pre class="recovery">@Model.Recovery</pre></div>}
<form method="post" asp-page="/Setup" asp-page-handler="Complete" class="mt-4">@if(Model.Recovery!=null){<input type="hidden" asp-for="Recovery"/>}else{<label>Clave de recuperación que guardó<input asp-for="Recovery" type="password" required autocomplete="off"/><small>Si ya generó una clave, introduzca su copia guardada. No es necesario generar otra.</small></label>}<div class="form-grid"><label>Nombre completo<input asp-for="Name" required autocomplete="name"/></label><label>Usuario administrador<input asp-for="Username" required autocomplete="username"/></label><label>Contraseña inicial<input asp-for="Password" type="password" required minlength="12" autocomplete="new-password"/></label><label>Dependencia<input asp-for="Input.Dependency" required/></label><label>Unidad administrativa<input asp-for="Input.Unit" required/></label><label>Área responsable<input asp-for="Input.Area" required/></label><label>Ejercicio general<input asp-for="Input.Year" min="1900" max="9999"/></label></div><label class="check"><input asp-for="SavedRecovery"/> Guardé externamente la clave de recuperación.</label><button class="btn btn-primary">2. Verificar respaldo y finalizar</button></form>
</div>
