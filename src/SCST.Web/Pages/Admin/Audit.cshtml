@page
@model SCST.Web.Pages.Admin.AuditModel
@{ViewData["Title"]="Auditoría administrativa";}
<form method="get" class="panel filters"><label>Usuario<select asp-for="UserId"><option value="">Todos</option>@foreach(var u in Model.Users){<option value="@u.Id">@u.Name</option>}</select></label><label>Acción<input asp-for="Action"/></label><label>Folio<input asp-for="Folio"/></label><label>Fecha<input asp-for="Date" type="date"/></label><button class="btn btn-secondary">Filtrar</button></form><section class="panel table-responsive"><table class="table"><thead><tr><th>Fecha y hora</th><th>Usuario</th><th>Operación</th><th>Entidad</th><th>ID</th><th>Folio</th></tr></thead><tbody>@foreach(var a in Model.Items){<tr><td>@a.TimestampUtc.ToLocalTime()</td><td>@Model.Users.FirstOrDefault(u=>u.Id==a.UserId)?.Name</td><td>@a.Action</td><td>@a.Entity</td><td>@a.EntityId</td><td>@a.Folio</td></tr>}</tbody></table><div class="pagination-row"><span>@Model.Count registros · Página @Model.P</span>@if(Model.P>1){<a href="@Url.Page("Audit",new{Model.UserId,Model.Action,Model.Folio,Date=Model.Date?.ToString("yyyy-MM-dd"),P=Model.P-1})">Anterior</a>}@if(Model.P*25<Model.Count){<a href="@Url.Page("Audit",new{Model.UserId,Model.Action,Model.Folio,Date=Model.Date?.ToString("yyyy-MM-dd"),P=Model.P+1})">Siguiente</a>}</div></section>
