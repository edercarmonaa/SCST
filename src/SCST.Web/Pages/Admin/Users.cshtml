@page
@model SCST.Web.Pages.Admin.UsersModel
@{ViewData["Title"]="Usuarios";}
<div asp-validation-summary="All" class="text-danger"></div><section class="panel"><h2>Cuentas locales</h2>@foreach(var u in Model.Items){<form method="post" asp-page-handler="Manage" class="user-row"><input name="id" value="@u.Id" type="hidden"/><div><strong>@u.Name</strong><small>@u.Username · @(u.Active?"Activo":"Inactivo")</small></div><label>Rol<select name="role">@foreach(var r in Enum.GetValues<Role>()){<option selected="@(r==u.Role)">@r</option>}</select></label><label class="check"><input type="checkbox" name="active" value="true" checked="@u.Active"/>Activo</label><label>Restablecer con contraseña temporal<input type="password" name="temporary" autocomplete="new-password" minlength="12"/></label><button class="btn btn-secondary">Guardar</button></form>}</section><section class="panel"><h2>Crear usuario</h2><form method="post"><div class="form-grid"><label>Nombre completo<input asp-for="Name" required/></label><label>Usuario<input asp-for="Username" required/></label><label>Contraseña temporal<input asp-for="Password" type="password" required minlength="12" autocomplete="new-password"/></label><label>Rol<select asp-for="Role" asp-items="Html.GetEnumSelectList<Role>()"></select></label></div><button class="btn btn-primary">Crear cuenta</button></form></section>
