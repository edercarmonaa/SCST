@page
@model SCST.Web.Pages.Admin.CatalogsModel
@{ViewData["Title"]="Catálogos y validadores";}
<div class="two-columns"><section class="panel"><h2>@(Model.Input.Id==0?"Agregar elemento":"Editar elemento")</h2><div asp-validation-summary="All" class="text-danger"></div><form method="post"><input asp-for="Input.Id" type="hidden"/><label>Catálogo<select asp-for="Input.Kind" asp-items="Html.GetEnumSelectList<CatalogKind>()"></select></label><label>Nombre<input asp-for="Input.Name" required/></label><label class="check"><input asp-for="Input.Active"/>Activo</label><label class="check"><input asp-for="Input.Pending"/>Estatus pendiente para semáforo (solo estatus)</label><label class="check"><input asp-for="ConfirmPending"/>Confirmo desactivar al validador aunque tenga pendientes.</label><button class="btn btn-primary">Guardar</button><a asp-page="Catalogs">Nuevo</a></form></section><section class="panel"><h2>Elementos registrados</h2>@foreach(var group in Model.Items.GroupBy(x=>x.Kind)){<h3>@group.Key</h3>@foreach(var c in group){<div class="summary-row"><span>@c.Name <small>@(!c.Active?"Inactivo":"")</small></span><a asp-route-edit="@c.Id">Editar</a></div>}}</section></div>
