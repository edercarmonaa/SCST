@page
@model TrashModel
@{ViewData["Title"]="Papelera";}
<form method="get" class="toolbar"><label>Tipo de registro<select asp-for="Entity"><option value="Tramite">Trámites</option><option value="Oficio">Oficios</option><option value="FollowUp">Seguimientos</option><option value="Reentry">Reingresos</option></select></label><button class="btn btn-secondary">Consultar</button></form><div class="panel"><p>Los folios permanecen reservados. No se permite eliminar definitivamente. Los seguimientos del expediente eliminado reaparecen al restaurarlo.</p><table class="table"><thead><tr><th>Registro</th><th>Acción</th></tr></thead><tbody>@foreach(var i in Model.Items){<tr><td>@i.Label</td><td><form method="post" data-confirm="¿Restaurar este registro?"><input name="entity" value="@i.Entity" type="hidden"/><input name="id" value="@i.Id" type="hidden"/><button class="btn btn-sm btn-outline-primary">Restaurar</button></form></td></tr>}</tbody></table>@if(Model.Count==0){<p class="empty">La papelera no contiene registros de este tipo.</p>}<div class="pagination-row"><span>@Model.Count registros · Página @Model.P</span>@if(Model.P>1){<a asp-route-Entity="@Model.Entity" asp-route-P="@(Model.P-1)">Anterior</a>}@if(Model.P*25<Model.Count){<a asp-route-Entity="@Model.Entity" asp-route-P="@(Model.P+1)">Siguiente</a>}</div></div>
