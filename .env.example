# Referencia de configuración. ASP.NET Core NO carga este archivo automáticamente.
# Establezca los valores con $env:NOMBRE en PowerShell antes de iniciar.
# No se necesita contraseña de base de datos, token ni API key.

# Opcional: vacío usa %LOCALAPPDATA%/SCSTData. Debe ser una carpeta local privada.
SCST_DATA=

# Opcional: puerto de loopback. Use otro para pruebas aisladas.
SCST_PORT=5186

# Entorno de ejecución; Development solo para desarrollo local con datos ficticios.
ASPNETCORE_ENVIRONMENT=Production

# Solo mantenimiento: restore.ps1 establece esta ruta para su proceso auxiliar.
# No es una clave. No coloque aquí la clave de recuperación ni contraseñas.
SCST_BACKUP=
